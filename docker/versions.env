# Every version baked into the images, in one place.
#
# Read by the justfiles (root and docker/) via `set dotenv-filename` and handed
# to `podman build` as --build-arg-file, so the file itself is what the build
# consumes. The Dockerfiles keep identical ARG defaults so a bare
# `podman build -f docker/base.dockerfile` still works; when the two drift, this
# file wins for `just` builds.
#
# Format: plain KEY=VALUE, no `export`, no quoting. That is also exactly what
# `podman build --build-arg-file` accepts.
#
# To override one version for a single run, pass an explicit --build-arg, which
# podman merges over the file:
#   podman build -f docker/base.dockerfile --build-arg-file versions.env \
#       --build-arg DSH_VERSION=0.2.3 .

# The Ubuntu base. Accepts a tag or a digest; pin by digest for an exact base:
#   podman build ... --build-arg-file versions.env \
#       --build-arg UBUNTU_IMAGE=ubuntu@sha256:<digest> .
UBUNTU_IMAGE=ubuntu:26.04

# Core CLI tooling. `just` is not packaged reliably in every Ubuntu release, so
# it comes from its official release tarball rather than apt.
JUST_VERSION=1.36.0

# Node toolchain, installed via nvm.
NVM_VERSION=0.41.0
NODE_VERSION=26.13.1
NPM_VERSION=12.2.2
COREPACK_VERSION=0.36.0
# Pinned explicitly: corepack's bare `pnpm` resolves from its bundled known-good
# table, which moves with COREPACK_VERSION and is otherwise unstatable here.
PNPM_VERSION=12.18.0

# DSH itself. Pinned exactly — npm's `latest` dist-tag currently points at an
# older release than `next`, so an unpinned install would silently build a
# different harness than the one named here.
DSH_VERSION=0.2.2-rc.2

# Go toolchain and gopls. The distro's Go is too old to build gopls
# (gopls v0.24.0 declares `go 1.27.0`), so the official toolchain is used.
GO_VERSION=1.27.3
GOPLS_VERSION=v0.24.0
